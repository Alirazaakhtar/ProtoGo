{
  "expo": {
    "name": "ProtoGo",
    "slug": "ProtoGo",
    "version": "1.0.0",

    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "protogo",

    "userInterfaceStyle": "light",

    "backgroundColor": "#FFFFFF",

    "primaryColor": "#1E3A5F",

    "ios": {
      "supportsTablet": false,

      "bundleIdentifier": "com.alirazaakhtar.protogo",

      "icon": "./assets/images/icon.png",

      "config": {
        "usesNonExemptEncryption": false
      }
    },

    "android": {
      "icon": "./assets/images/icon.png",

      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#FFFFFF"
      },

      "predictiveBackGestureEnabled": false,

      "package": "com.alirazaakhtar.protogo"
    },

    "web": {
      "output": "static",

      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",

          "image": "./assets/images/splash-icon.png",

          "imageWidth": 200,

          "resizeMode": "contain",

          "ios": {
            "backgroundColor": "#FFFFFF",

            "image": "./assets/images/splash-icon.png",

            "imageWidth": 200,

            "resizeMode": "contain"
          },

          "android": {
            "backgroundColor": "#FFFFFF",

            "image": "./assets/images/splash-icon.png",

            "imageWidth": 200,

            "resizeMode": "contain"
          }
        }
      ],

      "expo-font",

      "expo-image",

      "expo-web-browser",

      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ],

      "expo-notifications"
    ],

    "experiments": {
      "typedRoutes": true,

      "reactCompiler": true
    },

    "extra": {
      "router": {},

      "eas": {
        "projectId": "2deea2a5-d685-46da-9407-8289fd3bd460"
      }
    }
  }
}